<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="DataTable">
    <listeners>
        <listener class-name="commons.MethodListener"></listener>
        <listener class-name="reportConfigs.ReportNGListener"></listener>
        <listener class-name="org.uncommons.reportng.HTMLReporter"/>
        <listener class-name="org.uncommons.reportng.JUnitXMLReporter"/>
    </listeners>
    <parameter name="url" value="https://blueimp.github.io/jQuery-File-Upload/"/>

    <test name="Run on Firefox browser">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.jquery.Level_12_Upload"/>
        </classes>
    </test>
</suite>