<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="NopCommerce Automation Testing">
    <listeners>
        <listener class-name="commons.MethodListener"></listener>
    </listeners>

    <parameter name="userUrl" value="http://demo.nopcommerce:5000/"/>
    <parameter name="adminUrl" value="http://demo.nopcommerce:5000/admin"/>

    <test name="Run on Firefox browser">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.nopcommerce.user.Level_19_Pattern_Object"/>
        </classes>
    </test>
</suite> 