<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="Orange HRM 5">
    <listeners>
        <listener class-name="actions.commons.MethodListener"></listener>
    </listeners>

    <!--    <parameter name="url" value="https://opensource-demo.orangehrmlive.com/"/>-->
    <parameter name="url" value="http://automationtada.edu:90/orangehrm5"/>

    <test name="Run on Chrome Headless browser">
        <parameter name="browser" value="head_chrome"/>
        <classes>
            <class name="com.orangehrm.Level_23_Browser_Config"/>
        </classes>
    </test>

    <test name="Run on Firefox Headless browser">
        <parameter name="browser" value="head_firefox"/>
        <classes>
            <class name="com.orangehrm.Level_23_Browser_Config"/>
        </classes>
    </test>

    <test name="Run on Edge Headless browser">
        <parameter name="browser" value="head_edge"/>
        <classes>
            <class name="com.orangehrm.Level_23_Browser_Config"/>
        </classes>
    </test>
</suite> 