<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="DataTable">
    <listeners>
        <listener class-name="commons.MethodListener"></listener>
        <listener class-name="reportConfigs.ExtentListenerV3" />
    </listeners>
    <parameter name="url" value="https://www.jqueryscript.net/demo/CRUD-Data-Grid-Plugin-jQuery-Quickgrid/"/>

    <test name="Run on Firefox browser">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.jquery.Level_15_ExtentReport_v3"/>
        </classes>
    </test>
</suite> 